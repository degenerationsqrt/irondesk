<resources xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <properties>
        <property id="pairingCode" type="string"></property>
        <property id="apiBaseUrl" type="string">https://irondeskpro.lovable.app</property>
    </properties>

    <settings>
        <setting propertyKey="@Properties.pairingCode" title="@Strings.PairingCodeTitle" prompt="@Strings.PairingCodePrompt">
            <settingConfig type="alphaNumeric" />
        </setting>
        <setting propertyKey="@Properties.apiBaseUrl" title="@Strings.ApiBaseUrlTitle" prompt="@Strings.ApiBaseUrlPrompt">
            <settingConfig type="url" />
        </setting>
    </settings>
</resources>
