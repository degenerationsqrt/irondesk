{
  "version": 1,
  "sdk_version": "0.28.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://pmjpsgqggxfgybbigtdc.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "irondesk-command",
      "version": "0.1.0",
      "title": "IronDesk Command"
    },
    "tools": [
      {
        "name": "list_recent_workouts",
        "title": "List recent workouts",
        "description": "List the signed-in athlete's most recent IronDesk workout sessions with status, focus, effort and completion time.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "description": "How many sessions to return (default 10, max 50)."
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "active",
                "completed",
                "cancelled"
              ],
              "description": "Optional status filter."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_workout_detail",
        "title": "Get workout detail",
        "description": "Return one of the signed-in athlete's workout sessions with its exercises, targets and logged sets (weight, reps, RPE).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "description": "Workout session id."
            }
          },
          "required": [
            "session_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_program_status",
        "title": "Get assigned program status",
        "description": "Show the signed-in athlete's assigned training program enrollments (program name, status, cycle, position) and the next planned sessions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "log_recovery",
        "title": "Log recovery entry",
        "description": "Create or update the signed-in athlete's recovery entry for a day: sleep, resting HR, HRV, fatigue, stress and readiness. Omitted fields keep existing real values; untouched sample values are discarded. An empty note clears the note.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "day": {
              "type": "string",
              "description": "ISO date (YYYY-MM-DD). Defaults to today in your profile timezone."
            },
            "sleep_hours": {
              "type": "number",
              "minimum": 0,
              "maximum": 24,
              "description": "Hours slept, 0-24."
            },
            "resting_hr": {
              "type": "integer",
              "minimum": 25,
              "maximum": 140,
              "description": "Resting heart rate, 25-140 bpm."
            },
            "hrv_ms": {
              "type": "integer",
              "minimum": 5,
              "maximum": 300,
              "description": "HRV, 5-300 milliseconds."
            },
            "readiness": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "description": "Readiness score, 0-100."
            },
            "fatigue": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Fatigue rating, 1-10."
            },
            "stress": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10,
              "description": "Stress rating, 1-10."
            },
            "note": {
              "type": "string",
              "maxLength": 500,
              "description": "Note, up to 500 characters."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "log_body_metric",
        "title": "Log body metric",
        "description": "Record a body measurement (weight in kg, body-fat percent, waist in cm) for the signed-in athlete.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "weight_kg": {
              "type": "number",
              "minimum": 20,
              "maximum": 400,
              "description": "Body weight, 20-400 kilograms."
            },
            "body_fat_percent": {
              "type": "number",
              "minimum": 2,
              "maximum": 70,
              "description": "Body fat, 2-70 percent."
            },
            "waist_cm": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 999.9,
              "description": "Waist measurement in centimeters."
            },
            "recorded_at": {
              "type": "string",
              "format": "date-time",
              "description": "ISO timestamp with a timezone (Z or an offset). Defaults to now."
            },
            "note": {
              "type": "string",
              "maxLength": 500,
              "description": "Note, up to 500 characters."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
